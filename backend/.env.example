PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/espa-international

# Meta WhatsApp Cloud API webhook (GET hub.verify_token must match)
WHATSAPP_VERIFY_TOKEN=espa_wa_verify_token_2026

# Ozonetel/CloudAgent webhook validation key
OZONETEL_API_KEY=replace_with_secure_key

# Optional CloudAgent click-to-call config
CLOUDAGENT_BASE_URL=https://cloudagent.ozonetel.com
CLOUDAGENT_API_KEY=replace_with_cloudagent_api_key
CLOUDAGENT_CAMPAIGN=replace_with_campaign_name

# AskEVA Interactive send-message API (Postman: backend.askeva.io/v1/message/send-message)
ASKEVA_MESSAGE_API_URL=https://backend.askeva.io
ASKEVA_API_TOKEN=replace_with_askeva_token
# Public URL AskEVA uses to fetch uploaded images/PDFs (production or ngrok)
PUBLIC_BASE_URL=https://espacrm.in
