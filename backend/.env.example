PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/espa-international

# Comma-separated extra frontend origins allowed via CORS (in addition to the
# localhost, production, and dev-server origins already hardcoded in server.js)
FRONTEND_URLS=https://crm.espainternational.co.in

# Meta WhatsApp Cloud API webhook (GET hub.verify_token must match)
WHATSAPP_VERIFY_TOKEN=espa_wa_verify_token_2026

# Ozonetel/CloudAgent webhook validation key
OZONETEL_API_KEY=replace_with_secure_key

# Optional CloudAgent click-to-call config
CLOUDAGENT_BASE_URL=https://cloudagent.ozonetel.com
CLOUDAGENT_API_KEY=replace_with_cloudagent_api_key
CLOUDAGENT_CAMPAIGN=replace_with_campaign_name

# TeleCMI integration (real click-to-call + CDR) - initial defaults, editable via Settings > API & Integrations
TELECMI_FROM_NUMBER=replace_with_telecmi_from_number
# Key TeleCMI must send back when calling our webhook (header x-api-key, Bearer token, or apiKey field)
TELECMI_WEBHOOK_API_KEY=replace_with_telecmi_webhook_api_key

# AskEVA Interactive send-message API (Postman: backend.askeva.io/v1/message/send-message)
ASKEVA_MESSAGE_API_URL=https://backend.askeva.io
ASKEVA_API_TOKEN=replace_with_askeva_token
# Public URL AskEVA uses to fetch uploaded images/PDFs (production or ngrok)
PUBLIC_BASE_URL=https://espacrm.in

# ZenXAI Public Voice API (crm.zenxai.io). When ZENXAI_API_KEY + ZENXAI_API_ASSISTANT_ID are set,
# missed-call AI call-backs go to POST {BASE}/assistants/{ID}/calls instead of the legacy make_call.
# Real values go in backend/.env only (git-ignored) — never in this tracked file.
ZENXAI_API_BASE_URL=https://crm.zenxai.io/api/public/v1
ZENXAI_API_ASSISTANT_ID=replace_with_zenxai_assistant_id
# zxk_live_... key from Voice Agents > assistant > Configuration > API Access
ZENXAI_API_KEY=replace_with_zenxai_api_key
# Optional: Call Data key that receives the customer name (only after adding it in the Call Data tab)
ZENXAI_API_NAME_INPUT_KEY=
# whsec_... signing secret from API Access; when set, webhook events without a valid X-ZenX-Signature are rejected
ZENXAI_WEBHOOK_SECRET=replace_with_zenxai_webhook_secret

# ZenXAI FEEDBACK assistant (Public Voice API) - called once, automatically, after the AI
# call-back above ends "completed" (answered). Each assistant has its OWN API key + signing secret.
ZENXAI_FEEDBACK_API_ASSISTANT_ID=replace_with_feedback_assistant_id
# Full zxk_live_... key from Voice Agents > feedback > Configuration > API Access
ZENXAI_FEEDBACK_API_KEY=replace_with_feedback_api_key
# whsec_... signing secret of the FEEDBACK assistant (its webhook uses the same URL: /api/calls/zenxai-events)
ZENXAI_FEEDBACK_WEBHOOK_SECRET=replace_with_feedback_webhook_secret
# Optional: wait before the feedback call (ms, default 60000), minimum AI call-back length (s, default 0 = none),
# and ZENXAI_FEEDBACK_AUTO=false to switch the automatic feedback call off
ZENXAI_FEEDBACK_DELAY_MS=60000
ZENXAI_FEEDBACK_MIN_DURATION_SEC=0
ZENXAI_FEEDBACK_AUTO=true
